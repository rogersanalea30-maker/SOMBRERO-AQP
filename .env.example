# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE FACTURACIÓN ELECTRÓNICA SUNAT (UBL 2.1)
# INNOVAFLOW PERÚ - PLANTILLA DE CONFIGURACIÓN SEGURA
# ==============================================================================

# Entorno de SUNAT: BETA o PRODUCTION
SUNAT_ENV=BETA

# URLs de los Web Services de SUNAT (BillService)
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PROD_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# Datos del Emisor (Empresa)
EMISOR_RUC=20000000001
EMISOR_RAZON_SOCIAL=EMPRESA DE PRUEBA S.A.C.
EMISOR_NOMBRE_COMERCIAL=MI TIENDA ONLINE
EMISOR_UBIGEO=150101
EMISOR_DIRECCION=AV. REPUBLICA DE PANAMA 3055 - SAN ISIDRO
EMISOR_CODIGO_ESTABLECIMIENTO=0000

# Credenciales de Usuario Secundario (Clave SOL)
# En BETA de SUNAT se utiliza comúnmente el usuario MODDATOS y clave moddatos
SUNAT_USER=MODDATOS
SUNAT_PASSWORD=moddatos

# Certificado Digital (.pfx o .p12)
CERT_PATH=app/certificates/certificate.pfx
CERT_PASSWORD=tu_password_del_certificado

# Directorio de almacenamiento de XMLs, ZIPs y CDRs
STORAGE_DIR=app/storage

# Base de Datos PostgreSQL (Supabase)
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT]:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Configuración del Servidor
DEBUG=True
PORT=8000
HOST=0.0.0.0
