# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Archivos de entorno y certificados privados
.env
app/certificates/*.pfx
app/certificates/*.p12
app/certificates/*.key
app/certificates/*.pem
