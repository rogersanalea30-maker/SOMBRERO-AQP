app/storage/zip/*
!app/storage/zip/.gitkeep
app/storage/cdr/*
!app/storage/cdr/.gitkeep
app/storage/pdf/*
!app/storage/pdf/.gitkeep
*.db
app/storage/facturacion.db

# IDEs y sistemas
.vscode/
.idea/
*.swp
.DS_Store

